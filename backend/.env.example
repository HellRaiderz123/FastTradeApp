# =============================================================================
# FastTradeApp — Self-Hosted Instance Configuration
# =============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in YOUR values below — never commit .env to version control.
# 3. Generate a secret key:  python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================


# =============================================================================
# BROKER — ZERODHA  (required)
# Get API key & secret from https://developers.kite.trade/
# =============================================================================

ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here

# Access token — refreshed daily by auto-login (leave blank on first run)
ZERODHA_ACCESS_TOKEN=

# Auto-login credentials — Zerodha client ID, login password, and TOTP secret.
# TOTP secret is the raw Base32 key shown when setting up 2FA in Zerodha (not the 6-digit code).
# Leave blank to disable auto-login and refresh the token manually each morning.
ZERODHA_USER_ID=your_zerodha_client_id
ZERODHA_PASSWORD=your_zerodha_password
ZERODHA_TOTP_SECRET=your_totp_base32_secret

# NRML (carry-forward) or MIS (intraday margin)
ZERODHA_PRODUCT=NRML

# PAPER_TRADING | ZERODHA_DRY_RUN | ZERODHA_LIVE
# Start with PAPER_TRADING — no real orders are placed
EXECUTION_MODE=PAPER_TRADING

# Which broker is active: ZERODHA | INDMONEY
ACTIVE_BROKER=ZERODHA


# =============================================================================
# BROKER — INDMONEY  (optional — leave blank if not using)
# =============================================================================

INDMONEY_ACCESS_TOKEN=
INDMONEY_API_KEY=
INDMONEY_CLIENT_ID=
INDMONEY_ALGO_ID=99999
INDMONEY_BASE_URL=https://api.indstocks.com
INDMONEY_EXCHANGE=NSE
INDMONEY_SEGMENT=DERIVATIVE
INDMONEY_PRODUCT=MARGIN
INDMONEY_ORDER_TYPE=MARKET
INDMONEY_VALIDITY=DAY
INDMONEY_ORDER_PATH=/order
INDMONEY_PAYLOAD_STYLE=flat
INDMONEY_HTTP_TIMEOUT_SECONDS=15
INDMONEY_INSTRUMENTS_CACHE_TTL_SECONDS=900
INDMONEY_SECURITY_MAP_JSON={}


# =============================================================================
# DATABASE  (Docker Compose sets this up automatically)
# Change the password to something unique before first launch.
# =============================================================================

DATABASE_URL=postgresql://fasttrade:change_this_db_password@db:5432/fasttrade

# Neon cloud backup (optional — hourly delta sync to Neon Postgres)
# Leave blank to skip cloud backup
NEON_SYNC_URL=
NEON_PASSWORD=
NEON_USER=
NEON_HOST=
NEON_PORT=5432
NEON_DB=


# =============================================================================
# AUTHENTICATION  (required — protects all API routes)
# Generate secret:  python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

AUTH_ENABLED=true

# Your login username and password for the app
AUTH_USERNAME=admin
AUTH_PASSWORD=change_this_strong_password

# REQUIRED: Generate a unique random secret — never share or commit this
AUTH_SECRET_KEY=REPLACE_WITH_python_secrets_token_hex_32_output
AUTH_TOKEN_EXPIRE_MINUTES=480


# =============================================================================
# NOTIFICATIONS — GMAIL / SMTP  (optional)
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
# =============================================================================

NOTIFY_GMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
ALERT_EMAIL=your_email@gmail.com


# =============================================================================
# NOTIFICATIONS — TELEGRAM  (optional)
# 1. Message @BotFather to create a bot -> get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot -> get your TELEGRAM_CHAT_ID
# =============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# =============================================================================
# EXTERNAL APIs  (optional)
# =============================================================================

# newsdata.io — stock-specific news feed (free tier available)
NEWSDATA_API_KEY=

# Twitter / X API v2 — market sentiment monitoring
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=


# =============================================================================
# RISK MANAGEMENT
# =============================================================================

RISK_PER_TRADE=2
MAX_TRADES_PER_DAY=5


# =============================================================================
# CANDLE DATA & SCHEDULER
# =============================================================================

CANDLES_SOURCE=ZERODHA
SAVE_CANDLES_TO_DB=1
DAILY_CANDLES_DAYS=900
DAILY_BACKFILL_DELAY_MINUTES=5
VIX_BACKFILL_DELAY_MINUTES=2


# =============================================================================
# STOCK ML MODEL  (optional — enable after initial setup)
# =============================================================================

STOCK_ML_ENABLED=false
STOCK_ML_TIMEFRAME=daily
STOCK_ML_MODEL_NAME=stock_daily_model.joblib
STOCK_DAILY_SYMBOLS=
STOCK_ML_MAX_CANDLES=1200
STOCK_ML_MIN_ROWS=300
STOCK_ML_HORIZON=5
STOCK_ML_RSI_PERIOD=14
STOCK_ML_ADX_PERIOD=14
STOCK_ML_EMA_FAST=20
STOCK_ML_EMA_SLOW=50
STOCK_ML_EMA_LONG=200
STOCK_ML_VOL_WINDOW=20
STOCK_ML_RET_SHORT=5
STOCK_ML_RET_LONG=20
STOCK_ML_RETURN_THRESHOLD=0.01
STOCK_ML_BULLISH_PROB=0.55
STOCK_ML_BEARISH_PROB=0.45
STOCK_ML_MIN_CONFIDENCE=60


# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
JSON_LOGS=false

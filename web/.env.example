# Backend host/port used by the Vite dev proxy (vite.config.ts)
# Defaults to 127.0.0.1:8000 if not set
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000

# Full base URL for API calls from the browser (e.g. in production without a proxy)
# Leave unset during local dev — the Vite proxy handles /api automatically
# VITE_API_BASE=https://api.yourdomain.com

# WebSocket host override (host:port) — used by useRealtimeQuotes
# Leave unset to auto-detect from window.location
# VITE_WS_HOST=api.yourdomain.com
